# SafeConnect Frontend Environment Variables Configuration (Vite)

# Production API Endpoint (HTTPS)
VITE_API_URL=https://api.safeconnect.example.com/api

# Production WebSocket Endpoint (WSS / HTTPS)
VITE_SOCKET_URL=https://api.safeconnect.example.com
VITE_WS_URL=wss://api.safeconnect.example.com

# Web Push VAPID Public Key (Safe for client-side exposure)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key-here
